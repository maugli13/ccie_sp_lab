router bgp 64502
 vrf CustC
  address-family ipv4 unicast
   allocate-label all
  !
  neighbor 10.2.12.2
   no address-family ipv4 unicast
   address-family ipv4 labeled-unicast
    route-policy PASS in
    route-policy PASS out
    as-override
   !
  !
 !
!
router static
 vrf CustC
  address-family ipv4 unicast
   10.2.12.2/32 GigabitEthernet0/0/0/3
  !
 !
!
