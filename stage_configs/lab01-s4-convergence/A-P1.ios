interface GigabitEthernet2
 bfd interval 500 min_rx 500 multiplier 3
 no bfd echo
!
interface GigabitEthernet3
 bfd interval 500 min_rx 500 multiplier 3
 no bfd echo
!
interface GigabitEthernet4
 bfd interval 500 min_rx 500 multiplier 3
 no bfd echo
!
interface GigabitEthernet5
 bfd interval 500 min_rx 500 multiplier 3
 no bfd echo
!
interface GigabitEthernet6
 ip ospf bfd disable
 ospfv3 bfd disable
!
interface GigabitEthernet7
 bfd interval 500 min_rx 500 multiplier 3
 no bfd echo
!
router ospf 1
 bfd all-interfaces
!
router ospfv3 1
 bfd all-interfaces
!
