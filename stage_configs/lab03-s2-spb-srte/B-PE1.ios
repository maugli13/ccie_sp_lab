router isis 1
 distribute link-state
!
router bgp 64502
 address-family link-state link-state
 !
 neighbor 10.2.0.7
  address-family link-state link-state
  !
 !
!
extcommunity-set opaque FLEX128
 128
end-set
!
route-policy SET_COLOR_128
  if extcommunity rt matches-any (64502:30) then
    set extcommunity color FLEX128
  endif
  pass
end-policy
!
router bgp 64502
 neighbor 10.2.0.7
  address-family vpnv4 unicast
   route-policy SET_COLOR_128 out
  !
  address-family vpnv6 unicast
   route-policy SET_COLOR_128 out
  !
 !
!
segment-routing
 traffic-eng
  segment-list SL_ALGO128_PE2
   index 10 mpls label 16650
  !
  policy EXPL_TO_PE2
   color 200 end-point ipv4 10.2.0.6
   candidate-paths
    preference 200
     explicit segment-list SL_ALGO128_PE2
     !
    !
   !
  !
  on-demand color 128
   dynamic
    pcep
    !
    metric
     type igp
    !
   !
   constraints
    segments
     sid-algorithm 128
    !
   !
  !
  pcc
   source-address ipv4 10.2.0.5
   pce address ipv4 10.2.0.7
   !
  !
 !
!
