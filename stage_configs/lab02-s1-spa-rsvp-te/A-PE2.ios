mpls traffic-eng tunnels
!
router ospf 1
 mpls traffic-eng router-id Loopback0
 mpls traffic-eng area 2
!
interface GigabitEthernet2
 mpls traffic-eng tunnels
 ip rsvp bandwidth 1000000
interface GigabitEthernet3
 mpls traffic-eng tunnels
 ip rsvp bandwidth 1000000
!
ip explicit-path name NORTH-PE2-PE1
 next-address loose 10.1.0.4
 next-address loose 10.1.0.1
ip explicit-path name SOUTH-PE2-PE1
 next-address loose 10.1.0.3
 next-address loose 10.1.0.2
ip explicit-path name DIAG-PE2-PE1
 next-address loose 10.1.0.3
 next-address loose 10.1.0.1
ip explicit-path name ANYLOOSE-PE1
 next-address loose 10.1.0.5
!
interface Tunnel20
 description TE to A-PE1 : NORTH primary / SOUTH secondary
 ip unnumbered Loopback0
 tunnel mode mpls traffic-eng
 tunnel destination 10.1.0.5
 tunnel mpls traffic-eng autoroute destination
 tunnel mpls traffic-eng bandwidth 100000
 tunnel mpls traffic-eng affinity 0x0 mask 0x80000000
 tunnel mpls traffic-eng path-option 10 explicit name NORTH-PE2-PE1
 tunnel mpls traffic-eng path-option 20 explicit name SOUTH-PE2-PE1
 tunnel mpls traffic-eng path-option 30 explicit name ANYLOOSE-PE1
 tunnel mpls traffic-eng fast-reroute node-protect
!
interface Tunnel21
 description TE to A-PE1 : explicit-path pinned to colored A-P3-A-P1 diagonal
 ip unnumbered Loopback0
 tunnel mode mpls traffic-eng
 tunnel destination 10.1.0.5
 tunnel mpls traffic-eng bandwidth 50000
 tunnel mpls traffic-eng path-option 10 explicit name DIAG-PE2-PE1
