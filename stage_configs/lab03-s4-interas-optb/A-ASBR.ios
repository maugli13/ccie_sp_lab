interface GigabitEthernet4.255
 encapsulation dot1Q 255
 ip address 10.255.0.1 255.255.255.252
 ipv6 address 2001:DB8:FF::1/64
!
router bgp 64501
 no bgp default route-target filter
!
ip extcommunity-list standard CUSTA-SPB permit rt 64502:10
ip extcommunity-list standard CUSTA-SPA permit rt 64501:10
!
route-map RM-OPTB-IN permit 10
 description Option B inbound: rewrite CustA RT 64502:10 -> 64501:10 (keep OSPF ext-comms)
 match extcommunity CUSTA-SPB
 set extcommunity rt 64501:10
!
route-map RM-OPTB-OUT permit 10
 description Option B outbound: advertise ONLY CustA (64501:10); deny CustC 64501:30
 match extcommunity CUSTA-SPA
!
router bgp 64501
 neighbor 10.255.0.2 remote-as 64502
 !
 address-family vpnv4 unicast
  neighbor 10.1.0.7 next-hop-self
  neighbor 10.255.0.2 activate
  neighbor 10.255.0.2 send-community extended
  neighbor 10.255.0.2 route-map RM-OPTB-IN in
  neighbor 10.255.0.2 route-map RM-OPTB-OUT out
 exit-address-family
 !
 address-family vpnv6 unicast
  neighbor 10.1.0.7 next-hop-self
  neighbor 10.255.0.2 activate
  neighbor 10.255.0.2 send-community extended
  neighbor 10.255.0.2 route-map RM-OPTB-IN in
  neighbor 10.255.0.2 route-map RM-OPTB-OUT out
 exit-address-family
!
