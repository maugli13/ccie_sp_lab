router bgp 64530
 bgp router-id 10.30.0.1
 bgp log-neighbor-changes
 neighbor 10.1.12.1 remote-as 64501
 neighbor 2001:DB8:1:24::1 remote-as 64501
 !
 address-family ipv4
  network 10.30.0.1 mask 255.255.255.255
  neighbor 10.1.12.1 activate
 exit-address-family
 !
 address-family ipv6
  network 2001:DB8:30::1/128
  neighbor 2001:DB8:1:24::1 activate
 exit-address-family
