router isis 1
 affinity-map CSR-EXIT bit-position 1
 flex-algo 128
  priority 100
  affinity exclude-any CSR-EXIT
  advertise-definition
 !
 interface Loopback0
  address-family ipv4 unicast
   prefix-sid algorithm 128 index 650
  !
 !
 interface GigabitEthernet0/0/0/4
  address-family ipv4 unicast
   metric 100
  !
 !
 interface GigabitEthernet0/0/0/0
  affinity flex-algo CSR-EXIT
 !
 interface GigabitEthernet0/0/0/1
  affinity flex-algo CSR-EXIT
 !
!
