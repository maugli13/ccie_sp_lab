interface Loopback0
 ip router isis
 ipv6 router isis
!
interface GigabitEthernet2
 ip router isis
 ipv6 router isis
 isis network point-to-point
!
interface GigabitEthernet3
 ip router isis
 ipv6 router isis
 isis network point-to-point
!
router isis
 net 49.0001.0102.0000.0008.00
 is-type level-2-only
 metric-style wide
 log-adjacency-changes
 passive-interface Loopback0
 address-family ipv6
  multi-topology
 exit-address-family
!
