interface GigabitEthernet4.254
 encapsulation dot1Q 254
 ip address 10.255.0.10 255.255.255.252
 ipv6 address 2001:DB8:FF:FE::2/64
!
ip prefix-list PL-SPB-LU-EXPORT seq 5 permit 10.2.0.6/32
ip prefix-list PL-SPB-LU-EXPORT seq 10 permit 10.2.0.7/32
!
route-map RM-LU-OUT permit 10
 match ip address prefix-list PL-SPB-LU-EXPORT
 set mpls-label
!
router bgp 64502
 neighbor 10.255.0.9 remote-as 64501
 !
 address-family ipv4
  neighbor 10.255.0.9 activate
  neighbor 10.255.0.9 route-map RM-LU-OUT out
  neighbor 10.255.0.9 send-label
 exit-address-family
!
router bgp 64502
 address-family ipv4
  neighbor 10.2.0.7 next-hop-self
 exit-address-family
!
