router ospf 1
 router-id 10.1.0.7
 passive enable
 area 0
  interface Loopback0
  !
  interface GigabitEthernet0/0/0/0
   passive disable
   network point-to-point
  !
 !
!
router ospfv3 1
 router-id 10.1.0.7
 passive
 area 0
  interface Loopback0
  !
  interface GigabitEthernet0/0/0/0
   passive disable
   network point-to-point
  !
 !
!
